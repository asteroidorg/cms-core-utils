{
  "name": "@asteroidcms/core-utils",
  "version": "0.1.7",
  "description": "Seamless integration utilities for Asteroid CMS — Apollo provider, content hooks, and rich-text rendering.",
  "keywords": [
    "asteroidcms",
    "cms",
    "headless-cms",
    "apollo",
    "react"
  ],
  "homepage": "https://cms.theasteroid.tech/docs",
  "bugs": {
    "url": "https://github.com/asteroidorg/cms-core-utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asteroidorg/cms-core-utils.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "abhidahal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@apollo/client": "^4.0.0",
    "graphql": "^16.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.10.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "graphql": "^16.9.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
